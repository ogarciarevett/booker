# Optional local configuration. Checks and simulations require no credentials.
# Empty values are unset. Runtime defaults are documented in README.md.
# Store credentials in 1Password; macOS Keychain is the local cache.
# Never commit a populated .env or personal identifiers.

# Live calls: named owner in disclosure
BOOKER_OWNER_NAME=

# Agent setup: public tool and webhook URLs
PUBLIC_BASE_URL=

# Agent setup, phone import, live calls and reconciliation
ELEVENLABS_API_KEY=

# Signed webhooks and live call readiness
ELEVENLABS_WEBHOOK_SECRET=

# Agent setup: consented owner voice
ELEVENLABS_VOICE_ID=

# Agent script path relative to the repository; defaults to locales/es-ES/agent.yaml
BOOKER_AGENT_SCRIPT=

# Phone import and ending calls
TWILIO_ACCOUNT_SID=

# Phone import and ending calls
TWILIO_AUTH_TOKEN=

# Phone import: outbound number
TWILIO_PHONE_NUMBER=

# Optional Jev routing in `pnpm route-task`
TYPESAFE_API_KEY=

# Optional Jev endpoint override
TYPESAFE_BASE_URL=

# Future OpenAI model profile; currently unused
OPENAI_API_KEY=

# Future Anthropic model profile; currently unused
ANTHROPIC_API_KEY=

# Future Gemini model profile; currently unused
GEMINI_API_KEY=

# Server binding; environment only
BOOKER_HOST=

# Server and call client
BOOKER_PORT=

# Database location; environment only
BOOKER_DATA_DIR=

# Dashboard connection to Booker
BOOKER_URL=

# Dashboard control token lookup
BOOKER_REPO_ROOT=

# Dashboard links to local traces
PHOENIX_URL=

# Optional traces with `pnpm serve:traced`
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Trace service and Phoenix project name
OTEL_SERVICE_NAME=

# Explicit tracing disable switch
OTEL_SDK_DISABLED=

# Node and Next.js runtime mode
NODE_ENV=

# Dashboard request guard; managed by Next.js
PORT=

# Next.js telemetry switch; managed
NEXT_TELEMETRY_DISABLED=

# Phoenix binding; managed
PHOENIX_HOST=

# Phoenix UI and OTLP receiver; managed
PHOENIX_PORT=

# Phoenix storage; managed
PHOENIX_WORKING_DIR=

# Phoenix telemetry switch; managed
PHOENIX_TELEMETRY_ENABLED=


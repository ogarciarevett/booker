{
  "name": "booker",
  "version": "0.0.0",
  "private": true,
  "description": "Personal assistant that places phone calls to gather quotes and make bookings.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/dashboard",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm privacy:scan",
    "simulate": "vitest run tests/scenarios --reporter=verbose",
    "route-task": "node scripts/route-task.ts",
    "booker": "node --env-file-if-exists=.env src/cli/main.ts",
    "serve:traced": "node --env-file-if-exists=.env --import ./src/observability/telemetry.ts src/cli/main.ts serve",
    "phoenix": "node scripts/phoenix.ts",
    "dashboard": "pnpm --filter @booker/dashboard dev",
    "dashboard:build": "pnpm --filter @booker/dashboard build",
    "db:generate": "drizzle-kit generate",
    "prepare": "lefthook install",
    "privacy:scan": "node scripts/personal-data-scan.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "20.14.5",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/otel": "1.2.0",
    "@libsql/client": "^0.18.0",
    "@napi-rs/keyring": "1.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.10",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
